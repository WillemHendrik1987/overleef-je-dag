{
  "headers": [
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://www.hanze.be https://hanze.be https://*.wixsite.com https://*.wix.com https://*.filesusr.com https://*.parastorage.com" }
    ] }
  ]
}
